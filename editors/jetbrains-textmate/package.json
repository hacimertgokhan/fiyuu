{
  "name": "fiu-language",
  "displayName": "Fiyuu (.fiu)",
  "description": "Syntax highlighting for Fiyuu framework .fiu files",
  "version": "0.1.0",
  "publisher": "fiyuu",
  "license": "MIT",
  "contributes": {
    "languages": [
      {
        "id": "fiu",
        "aliases": ["Fiyuu", "fiu"],
        "extensions": [".fiu"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fiu",
        "scopeName": "source.fiu",
        "path": "./fiu.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.fiu": "javascript",
          "meta.embedded.block.javascript.fiu": "javascript",
          "meta.embedded.block.css.fiu": "css",
          "meta.template.expression.fiu": "javascript"
        }
      }
    ],
    "themes": [
      {
        "label": "Fiyuu Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/fiyuu-neon-color-theme.json"
      }
    ]
  }
}
