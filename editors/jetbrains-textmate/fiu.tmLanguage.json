{
  "name": "Fiyuu",
  "scopeName": "source.fiu",
  "fileTypes": ["fiu"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#decorator-page" },
    { "include": "#decorator-layout" },
    { "include": "#decorator-query" },
    { "include": "#decorator-state" },
    { "include": "#decorator-component" },
    { "include": "#decorator-generic" },
    { "include": "#component-decl" },
    { "include": "#template-decl" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#braces" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fiu",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fiu",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "decorator-page": {
      "name": "meta.decorator.page.fiu",
      "begin": "(@page)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.fiu" },
        "2": { "name": "punctuation.definition.parameters.begin.fiu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.fiu" }
      },
      "patterns": [
        {
          "match": "([a-zA-Z_]\\w*)\\s*(=)\\s*((\"[^\"]*\")|('[^']*'))",
          "captures": {
            "1": { "name": "variable.parameter.fiu" },
            "2": { "name": "keyword.operator.assignment.fiu" },
            "3": { "name": "string.quoted.double.fiu" }
          }
        },
        { "include": "#strings" }
      ]
    },

    "decorator-layout": {
      "name": "meta.decorator.layout.fiu",
      "begin": "(@layout)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.fiu" },
        "2": { "name": "punctuation.definition.parameters.begin.fiu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.fiu" }
      },
      "patterns": [
        {
          "match": "([a-zA-Z_]\\w*)\\s*(=)\\s*((\"[^\"]*\")|('[^']*'))",
          "captures": {
            "1": { "name": "variable.parameter.fiu" },
            "2": { "name": "keyword.operator.assignment.fiu" },
            "3": { "name": "string.quoted.double.fiu" }
          }
        },
        { "include": "#strings" }
      ]
    },

    "decorator-query": {
      "name": "meta.decorator.query.fiu",
      "match": "(@query)\\s*(→|->)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "storage.modifier.fiu" },
        "2": { "name": "keyword.operator.arrow.fiu" },
        "3": { "name": "entity.name.type.class.fiu" }
      }
    },

    "decorator-state": {
      "name": "meta.decorator.state.fiu",
      "match": "(@state)\\s+([a-zA-Z_]\\w*)\\s*(=)",
      "captures": {
        "1": { "name": "storage.modifier.fiu" },
        "2": { "name": "variable.other.readwrite.fiu" },
        "3": { "name": "keyword.operator.assignment.fiu" }
      }
    },

    "decorator-component": {
      "name": "meta.decorator.component.fiu",
      "match": "(@component)\\b",
      "captures": {
        "1": { "name": "storage.modifier.fiu" }
      }
    },

    "decorator-generic": {
      "match": "(@[a-zA-Z_]\\w*)\\b",
      "captures": {
        "1": { "name": "storage.modifier.fiu" }
      }
    },

    "component-decl": {
      "name": "meta.component.declaration.fiu",
      "begin": "\\b(component)\\b",
      "end": "(?<=\\})",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.class.fiu" }
      },
      "patterns": [
        {
          "match": "\\s+([A-Z][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.type.fiu" }
          }
        },
        {
          "match": "\\s+([A-Z][a-zA-Z0-9_]*)\\s*(?=\\{)",
          "captures": {
            "1": { "name": "entity.name.type.fiu" }
          }
        },
        {
          "name": "meta.component.parameters.fiu",
          "begin": "\\(",
          "end": "\\)",
          "beginCaptures": { "0": { "name": "punctuation.definition.parameters.begin.fiu" } },
          "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.fiu" } },
          "patterns": [
            {
              "match": "\\b([a-z_]\\w*)\\b",
              "captures": { "1": { "name": "variable.parameter.fiu" } }
            },
            { "name": "punctuation.separator.parameter.fiu", "match": "," }
          ]
        },
        {
          "name": "meta.component.body.fiu",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.block.begin.fiu" } },
          "endCaptures": { "0": { "name": "punctuation.section.block.end.fiu" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#decorator-page" },
            { "include": "#decorator-layout" },
            { "include": "#decorator-query" },
            { "include": "#decorator-state" },
            { "include": "#decorator-component" },
            { "include": "#decorator-generic" },
            { "include": "#template-decl" },
            { "include": "#keywords" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#operators" }
          ]
        }
      ]
    },

    "template-decl": {
      "name": "meta.template.declaration.fiu",
      "begin": "\\b(template)\\s*(\\()",
      "end": "(?<=\\})",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.function.fiu" },
        "2": { "name": "punctuation.definition.parameters.begin.fiu" }
      },
      "patterns": [
        {
          "name": "meta.template.parameters.fiu",
          "begin": "(?<=template\\s*\\()|\\G",
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.fiu" } },
          "patterns": [
            {
              "match": "\\b([a-z_]\\w*)\\b",
              "captures": { "1": { "name": "variable.parameter.fiu" } }
            },
            { "name": "punctuation.separator.parameter.fiu", "match": "," }
          ]
        },
        {
          "name": "meta.template.body.fiu",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.block.begin.fiu" } },
          "endCaptures": { "0": { "name": "punctuation.section.block.end.fiu" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#closing-tag" },
            { "include": "#component-tag-selfclose" },
            { "include": "#component-tag-open" },
            { "include": "#html-tag-selfclose" },
            { "include": "#html-tag-open" },
            { "include": "#template-text" },
            { "include": "#numbers" }
          ]
        }
      ]
    },

    "closing-tag": {
      "name": "meta.tag.closing.fiu",
      "match": "(</)([A-Za-z][A-Za-z0-9-]*)(\\s*)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "entity.name.tag.fiu" },
        "4": { "name": "punctuation.definition.tag.end.fiu" }
      }
    },

    "component-tag-selfclose": {
      "name": "meta.tag.component.self-closing.fiu",
      "begin": "(<)([A-Z][A-Za-z0-9_]*)",
      "end": "/>",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "entity.name.type.instance.fiu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.end.fiu" }
      },
      "patterns": [
        { "include": "#tag-attributes" }
      ]
    },

    "component-tag-open": {
      "name": "meta.tag.component.open.fiu",
      "begin": "(<)([A-Z][A-Za-z0-9_]*)",
      "end": "(?<!/)>",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "entity.name.type.instance.fiu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.end.fiu" }
      },
      "patterns": [
        { "include": "#tag-attributes" }
      ]
    },

    "html-tag-selfclose": {
      "name": "meta.tag.html.self-closing.fiu",
      "begin": "(<)([a-z][a-zA-Z0-9-]*)",
      "end": "/>",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "entity.name.tag.html.fiu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.end.fiu" }
      },
      "patterns": [
        { "include": "#tag-attributes" }
      ]
    },

    "html-tag-open": {
      "name": "meta.tag.html.open.fiu",
      "begin": "(<)([a-z][a-zA-Z0-9-]*)",
      "end": "(?<!/)>",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "entity.name.tag.html.fiu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.end.fiu" }
      },
      "patterns": [
        { "include": "#tag-attributes" }
      ]
    },

    "tag-attributes": {
      "patterns": [
        {
          "comment": "prop={expr}",
          "name": "meta.attribute.binding.fiu",
          "begin": "([a-zA-Z_:][-a-zA-Z0-9_:.]*)\\s*(=)\\s*(\\{)",
          "end": "\\}",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name.fiu" },
            "2": { "name": "keyword.operator.assignment.fiu" },
            "3": { "name": "punctuation.section.embedded.begin.fiu" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.fiu" }
          },
          "patterns": [
            { "include": "#js-expr" }
          ]
        },
        {
          "comment": "attr=\"value\"",
          "match": "([a-zA-Z_:][-a-zA-Z0-9_:.]*)\\s*(=)\\s*(\"[^\"]*\"|'[^']*')",
          "captures": {
            "1": { "name": "entity.other.attribute-name.fiu" },
            "2": { "name": "keyword.operator.assignment.fiu" },
            "3": { "name": "string.quoted.double.html.fiu" }
          }
        },
        {
          "comment": "boolean attribute",
          "match": "\\b([a-zA-Z_][-a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.fiu" }
          }
        }
      ]
    },

    "template-text": {
      "patterns": [
        { "include": "#interpolation" },
        {
          "name": "string.unquoted.template.fiu",
          "match": "[^<>{}/]+"
        }
      ]
    },

    "interpolation": {
      "name": "meta.interpolation.fiu",
      "begin": "(\\{)(?=[^/}])",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "punctuation.section.embedded.begin.fiu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.fiu" }
      },
      "contentName": "source.js.embedded.fiu",
      "patterns": [
        { "include": "#js-expr" }
      ]
    },

    "js-expr": {
      "patterns": [
        { "include": "#strings" },
        { "include": "#numbers" },
        {
          "name": "keyword.control.fiu",
          "match": "\\b(if|else|for|while|return|const|let|var|function|class|new|typeof|instanceof|null|undefined|true|false|this|super|import|export|default|async|await|of|in|throw|try|catch|finally|switch|case|break|continue)\\b"
        },
        {
          "name": "support.function.fiu",
          "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)(?=\\s*\\()"
        },
        {
          "name": "variable.other.object.property.fiu",
          "match": "(?<=\\.)[a-zA-Z_$][a-zA-Z0-9_$]*"
        },
        {
          "name": "keyword.operator.fiu",
          "match": "=>|\\?\\.|\\?\\?|&&|\\|\\||\\.\\.\\.|===|!==|==|!=|>=|<=|[+\\-*/%=!<>&|^~?]"
        },
        {
          "name": "variable.other.fiu",
          "match": "\\b[a-zA-Z_$][a-zA-Z0-9_$.]*\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.class.fiu",
          "match": "\\b(component|template)\\b"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fiu",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.fiu" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.fiu" } },
          "patterns": [
            { "name": "constant.character.escape.fiu", "match": "\\\\." },
            { "include": "#template-string-interp" }
          ]
        },
        {
          "name": "string.quoted.single.fiu",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.fiu" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.fiu" } },
          "patterns": [
            { "name": "constant.character.escape.fiu", "match": "\\\\." },
            { "include": "#template-string-interp" }
          ]
        },
        {
          "name": "string.template.fiu",
          "begin": "`",
          "end": "`",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.fiu" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.fiu" } },
          "patterns": [
            { "include": "#template-string-interp" },
            { "name": "constant.character.escape.fiu", "match": "\\\\." }
          ]
        }
      ]
    },

    "template-string-interp": {
      "name": "meta.template.expression.fiu",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.fiu" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.fiu" } },
      "patterns": [
        { "include": "#js-expr" }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.fiu",
          "match": "→|->"
        },
        {
          "name": "keyword.operator.assignment.fiu",
          "match": "=(?!=)"
        }
      ]
    },

    "numbers": {
      "name": "constant.numeric.fiu",
      "match": "\\b(0x[0-9a-fA-F]+|\\d+\\.?\\d*([eE][+-]?\\d+)?)\\b"
    },

    "braces": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.fiu",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.fiu",
          "match": "\\}"
        },
        {
          "name": "punctuation.definition.parameters.begin.fiu",
          "match": "\\("
        },
        {
          "name": "punctuation.definition.parameters.end.fiu",
          "match": "\\)"
        },
        {
          "name": "punctuation.separator.comma.fiu",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.fiu",
          "match": ";"
        }
      ]
    }

  }
}
