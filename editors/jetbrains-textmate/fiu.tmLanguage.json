{
  "name": "Fiyuu",
  "scopeName": "source.fiu",
  "fileTypes": ["fiu"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#decorator-page" },
    { "include": "#decorator-layout" },
    { "include": "#decorator-query" },
    { "include": "#decorator-state" },
    { "include": "#decorator-component" },
    { "include": "#decorator-generic" },
    { "include": "#component-decl" },
    { "include": "#template-decl" },
    { "include": "#template-interpolation" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#braces" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fiu",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fiu",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "decorator-page": {
      "name": "meta.annotation.page.fiu",
      "begin": "(@page)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": { "name": "storage.type.annotation" },
        "2": { "name": "punctuation.definition.parameters.begin.fiu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.fiu" }
      },
      "patterns": [
        {
          "match": "([a-zA-Z_]\\w*)\\s*(=)\\s*((\"[^\"]*\")|('[^']*')|\\btrue\\b|\\bfalse\\b|\\b[a-zA-Z_]\\w*\\b|\\b\\d+(?:\\.\\d+)?\\b)",
          "captures": {
            "1": { "name": "variable.parameter" },
            "2": { "name": "keyword.operator.assignment" },
            "3": { "name": "meta.annotation.argument-value.fiu" }
          }
        },
        { "include": "#strings" }
      ]
    },

    "decorator-layout": {
      "name": "meta.annotation.layout.fiu",
      "begin": "(@layout)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": { "name": "storage.type.annotation" },
        "2": { "name": "punctuation.definition.parameters.begin.fiu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.fiu" }
      },
      "patterns": [
        {
          "match": "([a-zA-Z_]\\w*)\\s*(=)\\s*((\"[^\"]*\")|('[^']*')|\\btrue\\b|\\bfalse\\b|\\b[a-zA-Z_]\\w*\\b|\\b\\d+(?:\\.\\d+)?\\b)",
          "captures": {
            "1": { "name": "variable.parameter" },
            "2": { "name": "keyword.operator.assignment" },
            "3": { "name": "meta.annotation.argument-value.fiu" }
          }
        },
        { "include": "#strings" }
      ]
    },

    "decorator-query": {
      "name": "meta.annotation.query.fiu",
      "match": "(@query)\\s*(→|->)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "storage.type.annotation" },
        "2": { "name": "keyword.operator.arrow" },
        "3": { "name": "entity.name.type.class" }
      }
    },

    "decorator-state": {
      "name": "meta.annotation.state.fiu",
      "begin": "(@state)\\s+([a-zA-Z_]\\w*)\\s*(=)",
      "end": "(?=$|//|/\\*|\\n)",
      "beginCaptures": {
        "1": { "name": "storage.type.annotation" },
        "2": { "name": "variable.other.readwrite" },
        "3": { "name": "keyword.operator.assignment" }
      },
      "patterns": [
        { "include": "#strings" },
        { "include": "#numbers" },
        {
          "name": "constant.language.boolean",
          "match": "\\b(true|false|null|undefined)\\b"
        },
        {
          "name": "variable.other",
          "match": "\\b[a-zA-Z_$][a-zA-Z0-9_$.]*\\b"
        }
      ]
    },

    "decorator-component": {
      "name": "meta.annotation.component.fiu",
      "match": "(@component)\\b",
      "captures": {
        "1": { "name": "storage.type.annotation" }
      }
    },

    "decorator-generic": {
      "name": "meta.annotation.fiu",
      "match": "(@[a-zA-Z_]\\w*)\\b",
      "captures": {
        "1": { "name": "storage.type.annotation" }
      }
    },

    "component-decl": {
      "name": "meta.component.declaration.fiu",
      "begin": "\\b(component)\\b",
      "end": "(?<=\\})",
      "beginCaptures": {
        "1": { "name": "storage.type.class" }
      },
      "patterns": [
        {
          "match": "\\s+([A-Z][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.type.class" }
          }
        },
        {
          "match": "\\s+([A-Z][a-zA-Z0-9_]*)\\s*(?=\\{)",
          "captures": {
            "1": { "name": "entity.name.type.class" }
          }
        },
        {
          "name": "meta.component.parameters.fiu",
          "begin": "\\(",
          "end": "\\)",
          "beginCaptures": { "0": { "name": "punctuation.definition.parameters.begin.fiu" } },
          "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.fiu" } },
          "patterns": [
            {
              "match": "\\b([a-z_]\\w*)\\b",
              "captures": { "1": { "name": "variable.parameter" } }
            },
            { "name": "punctuation.separator.parameter.fiu", "match": "," }
          ]
        },
        {
          "name": "meta.component.body.fiu",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.block.begin.fiu" } },
          "endCaptures": { "0": { "name": "punctuation.section.block.end.fiu" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#decorator-page" },
            { "include": "#decorator-layout" },
            { "include": "#decorator-query" },
            { "include": "#decorator-state" },
            { "include": "#decorator-component" },
            { "include": "#decorator-generic" },
            { "include": "#template-decl" },
            { "include": "#template-interpolation" },
            { "include": "#keywords" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#operators" }
          ]
        }
      ]
    },

    "template-decl": {
      "name": "meta.template.declaration.fiu",
      "begin": "\\b(template)\\s*(\\()",
      "end": "(?<=\\})",
      "beginCaptures": {
        "1": { "name": "storage.type.function" },
        "2": { "name": "punctuation.definition.parameters.begin.fiu" }
      },
      "patterns": [
        {
          "name": "meta.template.parameters.fiu",
          "begin": "(?<=template\\s*\\()|\\G",
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.fiu" } },
          "patterns": [
            {
              "match": "\\b([a-z_]\\w*)\\b",
              "captures": { "1": { "name": "variable.parameter" } }
            },
            { "name": "punctuation.separator.parameter.fiu", "match": "," }
          ]
        },
        {
          "name": "meta.template.body.fiu",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.block.begin.fiu" } },
          "endCaptures": { "0": { "name": "punctuation.section.block.end.fiu" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#script-tag" },
            { "include": "#style-tag" },
            { "include": "#closing-tag" },
            { "include": "#component-tag-selfclose" },
            { "include": "#component-tag-open" },
            { "include": "#html-tag-selfclose" },
            { "include": "#html-tag-open" },
            { "include": "#template-text" },
            { "include": "#template-interpolation" },
            { "include": "#numbers" }
          ]
        }
      ]
    },

    "script-tag": {
      "name": "meta.tag.script.fiu",
      "begin": "(<)(script)\\b",
      "end": "(</)(script)(\\s*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "entity.name.tag.script" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "entity.name.tag.script" },
        "4": { "name": "punctuation.definition.tag.end.fiu" }
      },
      "patterns": [
        { "include": "#tag-attributes" },
        {
          "name": "meta.embedded.block.javascript.fiu",
          "begin": "(?<!/)>",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.tag.end.fiu" }
          },
          "end": "(?=</script\\s*>)",
          "contentName": "source.js",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#js-expr" }
          ]
        }
      ]
    },

    "style-tag": {
      "name": "meta.tag.style.fiu",
      "begin": "(<)(style)\\b",
      "end": "(</)(style)(\\s*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "entity.name.tag.style" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "entity.name.tag.style" },
        "4": { "name": "punctuation.definition.tag.end.fiu" }
      },
      "patterns": [
        { "include": "#tag-attributes" },
        {
          "name": "meta.embedded.block.css.fiu",
          "begin": "(?<!/)>",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.tag.end.fiu" }
          },
          "end": "(?=</style\\s*>)",
          "contentName": "source.css",
          "patterns": [
            {
          "name": "support.type.property-name.css",
              "match": "(^|[;{\\s])([a-zA-Z-]+)(?=\\s*:)",
              "captures": {
                "2": { "name": "support.type.property-name.css" }
              }
            },
            {
          "name": "keyword.operator.assignment.css",
              "match": ":"
            },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#template-interpolation" }
          ]
        }
      ]
    },

    "closing-tag": {
      "name": "meta.tag.closing.fiu",
      "match": "(</)([A-Za-z][A-Za-z0-9_-]*)(\\s*)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "entity.name.tag" },
        "4": { "name": "punctuation.definition.tag.end.fiu" }
      }
    },

    "component-tag-selfclose": {
      "name": "meta.tag.component.self-closing.fiu",
      "begin": "(<)([A-Z][A-Za-z0-9_]*)",
      "end": "/>",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "support.class.component" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.end.fiu" }
      },
      "patterns": [
        { "include": "#tag-attributes" }
      ]
    },

    "component-tag-open": {
      "name": "meta.tag.component.open.fiu",
      "begin": "(<)([A-Z][A-Za-z0-9_]*)",
      "end": "(?<!/)>",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "support.class.component" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.end.fiu" }
      },
      "patterns": [
        { "include": "#tag-attributes" }
      ]
    },

    "html-tag-selfclose": {
      "name": "meta.tag.html.self-closing.fiu",
      "begin": "(<)([a-z][a-zA-Z0-9-]*)",
      "end": "/>",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "entity.name.tag" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.end.fiu" }
      },
      "patterns": [
        { "include": "#tag-attributes" }
      ]
    },

    "html-tag-open": {
      "name": "meta.tag.html.open.fiu",
      "begin": "(<)([a-z][a-zA-Z0-9-]*)",
      "end": "(?<!/)>",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.fiu" },
        "2": { "name": "entity.name.tag" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.end.fiu" }
      },
      "patterns": [
        { "include": "#tag-attributes" }
      ]
    },

    "tag-attributes": {
      "patterns": [
        {
          "comment": "prop={expr}",
          "name": "meta.attribute.binding.fiu",
          "begin": "([a-zA-Z_:][-a-zA-Z0-9_:.]*)\\s*(=)\\s*(\\{)",
          "end": "\\}",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name" },
            "2": { "name": "keyword.operator.assignment" },
            "3": { "name": "punctuation.section.embedded.begin.fiu" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.fiu" }
          },
          "patterns": [
            { "include": "#js-expr" }
          ]
        },
        {
          "comment": "attr=\"value\"",
          "begin": "([a-zA-Z_:][-a-zA-Z0-9_:.]*)\\s*(=)\\s*(\")",
          "end": "\"",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name" },
            "2": { "name": "keyword.operator.assignment" },
            "3": { "name": "punctuation.definition.string.begin.html" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.html" }
          },
          "contentName": "string.quoted.double.html",
          "patterns": [
            { "include": "#quoted-attr-interpolation" }
          ]
        },
        {
          "comment": "attr='value'",
          "begin": "([a-zA-Z_:][-a-zA-Z0-9_:.]*)\\s*(=)\\s*(')",
          "end": "'",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name" },
            "2": { "name": "keyword.operator.assignment" },
            "3": { "name": "punctuation.definition.string.begin.html" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.html" }
          },
          "contentName": "string.quoted.single.html",
          "patterns": [
            { "include": "#quoted-attr-interpolation" }
          ]
        },
        {
          "comment": "boolean attribute",
          "match": "\\b([a-zA-Z_][-a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name" }
          }
        }
      ]
    },

    "template-text": {
      "patterns": [
        { "include": "#interpolation" },
        {
          "name": "string.unquoted.html",
          "match": "[^<>{}]+"
        }
      ]
    },

    "template-interpolation": {
      "name": "meta.embedded.expression.fiu",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.fiu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.fiu" }
      },
      "contentName": "source.js",
      "patterns": [
        { "include": "#js-expr" }
      ]
    },

    "quoted-attr-interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.expression.fiu",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.fiu" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.fiu" }
          },
          "contentName": "source.js",
          "patterns": [
            { "include": "#js-expr" }
          ]
        }
      ]
    },

    "interpolation": {
      "name": "meta.interpolation.fiu",
      "begin": "(\\{)(?=[^/}])",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "punctuation.section.embedded.begin.fiu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.fiu" }
      },
      "contentName": "source.js",
      "patterns": [
        { "include": "#js-expr" }
      ]
    },

    "js-expr": {
      "patterns": [
        { "include": "#strings" },
        { "include": "#numbers" },
        {
          "name": "comment.line.double-slash.js",
          "match": "//.*$"
        },
        {
          "name": "comment.block.js",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "keyword.control.js",
          "match": "\\b(if|else|for|while|return|const|let|var|function|class|new|typeof|instanceof|null|undefined|true|false|this|super|import|export|default|async|await|of|in|throw|try|catch|finally|switch|case|break|continue)\\b"
        },
        {
          "name": "storage.type.js",
          "match": "\\b(string|number|boolean|object|any|void|unknown|never)\\b"
        },
        {
          "name": "support.function.js",
          "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)(?=\\s*\\()"
        },
        {
          "name": "support.type.property-name.json",
          "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)(?=\\s*:)"
        },
        {
          "name": "variable.other.property",
          "match": "(?<=\\.)[a-zA-Z_$][a-zA-Z0-9_$]*"
        },
        {
          "name": "punctuation.accessor.js",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.key-value.js",
          "match": ":"
        },
        {
          "name": "keyword.operator.js",
          "match": "=>|\\?\\.|\\?\\?|&&|\\|\\||\\.\\.\\.|===|!==|==|!=|>=|<=|[+\\-*/%=!<>&|^~?]"
        },
        {
          "name": "constant.language.boolean.js",
          "match": "\\b(true|false|null|undefined)\\b"
        },
        {
          "name": "support.class",
          "match": "\\b(document|window|localStorage|Math|JSON|Object|Array|String|Number|Boolean|Set|Map|Date|console)\\b"
        },
        {
          "name": "variable.other",
          "match": "\\b[a-zA-Z_$][a-zA-Z0-9_$.]*\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "storage.type",
          "match": "\\b(component|template)\\b"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end" } },
          "patterns": [
            { "name": "constant.character.escape", "match": "\\\\." },
            { "include": "#template-string-interp" }
          ]
        },
        {
          "name": "string.quoted.single",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end" } },
          "patterns": [
            { "name": "constant.character.escape", "match": "\\\\." },
            { "include": "#template-string-interp" }
          ]
        },
        {
          "name": "string.template",
          "begin": "`",
          "end": "`",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end" } },
          "patterns": [
            { "include": "#template-string-interp" },
            { "name": "constant.character.escape", "match": "\\\\." }
          ]
        }
      ]
    },

    "template-string-interp": {
      "name": "meta.template.expression.fiu",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.fiu" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.fiu" } },
      "patterns": [
        { "include": "#js-expr" }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow",
          "match": "→|->"
        },
        {
          "name": "keyword.operator.assignment",
          "match": "=(?!=)"
        }
      ]
    },

    "numbers": {
      "name": "constant.numeric",
      "match": "\\b(0x[0-9a-fA-F]+|\\d+\\.?\\d*([eE][+-]?\\d+)?)\\b"
    },

    "braces": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.fiu",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.fiu",
          "match": "\\}"
        },
        {
          "name": "punctuation.definition.parameters.begin.fiu",
          "match": "\\("
        },
        {
          "name": "punctuation.definition.parameters.end.fiu",
          "match": "\\)"
        },
        {
          "name": "punctuation.separator.comma.fiu",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.fiu",
          "match": ";"
        }
      ]
    }

  }
}
